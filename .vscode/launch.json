{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    {
        "name": "JamSpell -fix(gdb) Launch",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/main/jamspell",
        "args": ["fix"
                , "${workspaceFolder}/build/main/model.bin"
                , "${workspaceFolder}/data/err.txt"
                , "${workspaceFolder}/build/main/fixed.txt" 
            ],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}/build/main/",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    },
    {
        "name": "JamSpell -train(gdb) Launch",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/main/jamspell",
        "args": ["train", "${workspaceFolder}/data/ru_en_alphabet.txt"
            , "${workspaceFolder}/data/test.txt"
            , "model.bin" 
        ],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}/build/main/",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    }
    ]
}